# Variables del backend (solo NOMBRES y valores de ejemplo — los reales viven en Render).
# En local el .env va en la RAÍZ del repo (está en .gitignore).

# ── Base de datos (Supabase) ──
DATABASE_URL=postgresql://usuario:clave@host:6543/postgres?pgbouncer=true
# Conexión directa para operaciones revisadas: puerto 5432, modo sesión. No usar `prisma db push` en la BD existente.
DIRECT_URL=postgresql://usuario:clave@host:5432/postgres
# Los scripts de preparación no leen .env ni usan DATABASE_URL: aportar esta variable explícitamente a cada ejecución.
CRM_DATABASE_URL=
# Solo PostgreSQL local de pruebas (localhost/127.0.0.1/::1); crea bases temporales crm_smoke_*.
CRM_TEST_DATABASE_URL=

# ── Seguridad ──
JWT_SECRET=                      # obligatorio en producción (el boot aborta sin él)
WEBHOOK_SECRET=                  # si está, POST /webhook exige x-webhook-secret (o ?secret=)
CRON_SECRET=                     # protege /cron/followup
CORS_ORIGINS=https://tu-crm.vercel.app
TENANT_ORIGINS=crm.cliente.com=tenant_id
ALLOW_TENANT_FALLBACK=           # 'true' solo si NO hay channels sembrados (instancia desconocida → ACTIVE_TENANT)

# ── Cerebro: cadena de proveedores (ver src/lib/llm-cadena.js) ──
BRAIN_PROVIDER=openrouter:openai/gpt-6-luna # Modelo elegido para este proyecto; proveedor:modelo explícito.
BRAIN_MODEL=                    # Solo Gemini; para otro proveedor el modelo va en BRAIN_PROVIDER.
BRAIN_LOCATION=                  # Gemini 3 → 'global' (se pone solo si queda vacío)
BRAIN_THINKING_LEVEL=            # Gemini 3: low | medium | high (default low)
BRAIN_FALLBACKS=openrouter:poolside/laguna-s-2.1,openrouter:google/gemini-3.1-flash-lite,mistral:ministral-14b-latest
# El orden define los seguros. Cada paso requiere su llave y acceso real al modelo; un ejemplo no confirma disponibilidad.
VISION_PROVIDER=                 # fotos por un proveedor OpenAI-compatible, ej: openrouter:google/gemini-3.1-flash-lite (vacío = Gemini directo)
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-credentials.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_DEV_API_KEY=              # Gemini Developer API (aistudio.google.com) — seguro recomendado
GROQ_API_KEY=                    # Whisper (audios) + seguro. El plan gratis NO aguanta el prompt del cerebro (413)
CEREBRAS_API_KEY=
# OpenAI-compatibles (src/lib/openai-compat.js): con la llave puesta entran solos como seguros.
# Probar cuál aguanta el turno real: node scripts/probar-cerebro.js
MISTRAL_API_KEY=                 # console.mistral.ai — verificar cuota y acceso en la cuenta.
OPENROUTER_API_KEY=              # openrouter.ai — consultar saldo, precios y límites de la cuenta antes de pruebas pagadas.
DEEPSEEK_API_KEY=                # platform.deepseek.com
NVIDIA_API_KEY=                  # build.nvidia.com
OPENAI_COMPAT_BASE_URL=          # cualquier otro OpenAI-compatible (Together, Fireworks, vLLM/Ollama propio)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── WhatsApp ──
WHATSAPP_PROVIDER=cloud          # API oficial de Meta. El proveedor de cada tenant se resuelve desde su canal en BD.
# Adaptador legacy aislado: solo configurar estas variables si existe un canal que lo requiera.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
# API oficial de Meta (Cloud API). La conexión de este proyecto ya está operativa.
# Estos valores de entorno corresponden al número del despliegue; otros canales necesitan sus propias credenciales.
CLOUD_APP_SECRET=                # app de Meta → Configuración → Básica → Clave secreta (sin esto no se aceptan webhooks)
CLOUD_APP_ID=                    # (solo para meta-activar.js) Identificador de la app: con él comprueba que la clave secreta y el token son de ESA app
CLOUD_VERIFY_TOKEN=              # lo inventamos nosotros; el mismo texto va en Meta → WhatsApp → Configuración → Webhook
CLOUD_ACCESS_TOKEN=              # token permanente de un usuario del sistema (whatsapp_business_messaging + _management)
CLOUD_PHONE_NUMBER_ID=           # el ID del número (no el teléfono)
CLOUD_WABA_ID=                   # el ID de la cuenta de WhatsApp Business DONDE ESTÁ el número (no la de prueba que Meta crea con la app)
# Plantillas: node scripts/meta-plantillas.js (estado), `crear --aplicar` las crea y `editar --aplicar` corrige su texto; al final imprime estas líneas ya con los nombres
# Webhook de Meta: además de "messages", suscribir message_template_status_update y template_category_update (avisa si una plantilla se pausa o cambia de categoría)
CLOUD_TEMPLATE_AVISO_VENDEDOR=   # plantilla de utilidad aprobada (3 variables: cliente, motivo, enlace) para que el aviso al vendedor llegue fuera de las 24 h
CLOUD_TEMPLATE_FOLLOWUP_24H=     # plantilla de marketing para el seguimiento de 24 h (sin ella, se omite)
CLOUD_TEMPLATE_COMPROMISO=       # plantilla para recordar compromisos fechados (sin ella, se omite)
CLOUD_TEMPLATE_REAPERTURA=       # plantilla (2 variables: nombre, producto) para reabrir desde la bandeja una conversación fuera de las 24 h
CLOUD_TEMPLATE_IDIOMA=es         # idioma con el que se crearon las plantillas (es, es_PE, es_MX… con guion bajo); lo usan todos los envíos de plantilla
CLOUD_TYPING_INDICATOR=true      # «leído» + «escribiendo…» mientras el bot piensa; false lo apaga sin desplegar código
ACTIVE_TENANT=                   # tenant por defecto del login (el webhook lo deduce del canal)
NUMERO_BOT=                      # número del bot (anti auto-mensaje / anti auto-aviso)
HUMAN_ACTIVE_RESUME_HORAS=6

# ── Observabilidad ──
SENTRY_DSN=
SENTRY_ENV=production
