generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════
// MOTOR v19 — Modelos legacy (intactos durante migración)
// ════════════════════════════════════════════════════════

// ─── Vendedores ───────────────────────────────────────────────
model Vendor {
  id                 Int                @id @default(autoincrement())
  // tenantId SIN default (jul 2026): el @default("peru_exporta") era una mina — cualquier
  // insert que olvidara el tenant aterrizaba silenciosamente en Perú Exporta (fue la causa
  // raíz de la contaminación entre clientes). Ahora es obligatorio: un insert sin tenant
  // FALLA en vez de contaminar. Todos los call sites lo setean explícito (verificado).
  tenantId           String             @map("tenant_id")
  nombre             String
  // telefono y whatsappNumber: únicos POR TENANT, no globales. El unique global impedía
  // dar de alta un cliente cuyo vendedor compartiera número con el de otro (pasó con
  // BIOAYUR: hubo que usar un placeholder). Con el compuesto, cada cliente usa su número real.
  telefono           String
  role               String             @default("VENDOR")
  activo             Boolean            @default(true)
  instanciaEvolution String?
  whatsappNumber     String?
  pin                String?            @default("0000")
  campaigns          Campaign[]
  leads              Lead[]
  conversations      Conversation[]
  leadStates         LeadState[]
  callEvents         CallEvent[]
  crmNotifications   CrmNotification[]
  archivedLeads      Lead[]             @relation("LeadArchivedBy")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([tenantId, telefono])
  @@unique([tenantId, whatsappNumber])
  @@index([tenantId])
  @@map("vendors")
}

// ─── Campañas ─────────────────────────────────────────────────
model Campaign {
  id            Int            @id @default(autoincrement())
  // tenantId sin default (ver Vendor): forgotten-tenant falla en vez de contaminar.
  tenantId      String         @map("tenant_id")
  // slug único POR TENANT: el unique global hacía que el 2º cliente que quisiera una
  // campaña "PROMO" fallara con error de constraint. Cada tenant tiene su espacio de slugs.
  slug          String
  nombre        String
  activa        Boolean        @default(true)
  vendorId      Int
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  triggers      Trigger[]
  steps         FlowStep[]
  leads         Lead[]
  conversations Conversation[]
  botPrompt     String?        @db.Text

  // ── Config declarativa del agente (Sprint 2) ──
  // La "pizarra" editable por el usuario desde su dashboard:
  // factSheet (precio/incluye/NO_incluye), agentGoal, autonomyLevel,
  // persona del agente, circuitBreaker, handoff, extras de atribución.
  // Los triggers y steps siguen como tablas (se editan pieza por pieza).
  config        Json?

  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("campaigns")
}

// ─── Triggers ─────────────────────────────────────────────────
model Trigger {
  id         Int      @id @default(autoincrement())
  texto      String
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("triggers")
}

// ─── Pasos del flujo ──────────────────────────────────────────
model FlowStep {
  id          Int      @id @default(autoincrement())
  orden       Int
  tipo        String   // MSG | FOLLOWUP | NOTIFY
  mensaje     String   @db.Text
  followupHrs Int?
  campaignId  Int
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, orden])
  @@map("flow_steps")
}

// ─── Leads ────────────────────────────────────────────────────
model Lead {
  id                Int                 @id @default(autoincrement())
  // tenantId sin default (ver Vendor): el lead es el dato más caliente y de mayor volumen;
  // un lead que cayera en el tenant equivocado por un default olvidado es lo peor que
  // puede pasar. Obligatorio y explícito en el único upsert (lead-resolver, verificado).
  tenantId          String              @map("tenant_id")
  telefono          String
  campaignId        Int?
  campaign          Campaign?           @relation(fields: [campaignId], references: [id])
  vendorId          Int?
  vendor            Vendor?             @relation(fields: [vendorId], references: [id])
  pasoActual        Int                 @default(0)
  ultimoMensaje     DateTime?            @db.Timestamp(6)
  notificado        Boolean             @default(false)
  estado            String              @default("NUEVO")
  nombreDetectado   String?
  productoDetectado String?

  // ── Direccionamiento WhatsApp (Sprint 2 — soporte @lid) ──
  // waJid: JID real al que responder (PN preferido, @lid como fallback).
  // addressingMode: 'pn' | 'lid' | 'lid_unrecovered' | 'unknown'.
  waJid             String?             @map("wa_jid")
  addressingMode    String?             @map("addressing_mode")
  
  // Soft delete fields (v20)
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(6)
  archivedReason    String?             @map("archived_reason")
  archivedById      Int?                @map("archived_by")
  archivedBy        Vendor?             @relation("LeadArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  
  mensajes          Message[]
  conversations     Conversation[]
  leadState         LeadState?
  turnTraces        TurnTrace[]
  callEvents        CallEvent[]
  commitments       Commitment[]
  followupQueue     FollowupQueueItem[]
  crmNotifications  CrmNotification[]
  mediaAssets       MediaAsset[]
  inboundEvents     InboundEvent[]
  outboundMessages  OutboundMessage[]
  followupReservations FollowupReservation[]
  createdAt         DateTime            @default(now()) @db.Timestamp(6)
  updatedAt         DateTime            @updatedAt @db.Timestamp(6)

  // Multitenancy: el teléfono es único POR TENANT, no global.
  // Evita que un mismo número robe el lead de un tenant a otro.
  @@unique([tenantId, telefono])
  @@index([tenantId])
  @@map("leads")
}

// ─── Conversaciones (fuente de verdad del bot v19) ────────────
model Conversation {
  id                      Int           @id @default(autoincrement())
  leadId                  Int
  lead                    Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId              Int?
  campaign                Campaign?     @relation(fields: [campaignId], references: [id])
  vendorId                Int?
  vendor                  Vendor?       @relation(fields: [vendorId], references: [id])
  state                   String        @default("ACTIVE")
  currentStep             Int           @default(0)
  lastBotMessageAt        DateTime?
  lastLeadMessageAt       DateTime?
  reactivationCount       Int           @default(0)
  lastReactivationAt      DateTime?
  vendorNotifiedAt        DateTime?
  vendorNotificationCount Int           @default(0)
  reminderJobId           String?
  messages                Message[]
  turnTraces              TurnTrace[]
  createdAt               DateTime      @default(now())

  @@unique([leadId, campaignId])
  @@map("conversations")
}

// ─── Historial de mensajes ────────────────────────────────────
// RECIBOS DE META (sep 2026). Hasta ahora un mensaje saliente se guardaba y ahí moría:
// nadie sabía si llegó. Con Evolution se notaba poco (el vendedor miraba su celular);
// con Cloud API pura el CRM es lo ÚNICO que hay, así que un mensaje que Meta rechazó
// —fuera de la ventana de 24 h, número que no tiene WhatsApp, plantilla no aprobada—
// se veía "enviado" en la bandeja y el lead nunca lo recibía.
//
// Meta manda esos recibos por el mismo webhook, en `statuses`, referenciando su propio
// id de mensaje (wamid). Por eso guardamos el wamid al enviar: es la única forma de
// enganchar el recibo con la fila. Todo es opcional a propósito — Evolution no da wamid
// y sus mensajes viven perfectamente con estas columnas en null.
model Message {
  id             Int           @id @default(autoincrement())
  leadId         Int
  lead           Lead          @relation(fields: [leadId], references: [id])
  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  origen         String        // LEAD | BOT | VENDEDOR
  texto          String        @db.Text
  createdAt      DateTime      @default(now()) @db.Timestamp(6)

  // wamid de Meta. Único a propósito: si el mismo envío se persistiera dos veces, la
  // base lo corta. En Postgres varios NULL no chocan entre sí → Evolution no se entera.
  waMessageId    String?       @unique @map("wa_message_id")
  cloudPhoneNumberId String?   @map("cloud_phone_number_id")
  status         String?       // sent | delivered | read | failed
  statusAt       DateTime?     @map("status_at")
  errorCode      Int?          @map("error_code")     // código de Meta (131047, 131026…)
  errorDetalle   String?       @map("error_detalle")

  @@index([status])
  @@map("messages")
}

// Recibos tempranos durables: conciliación por tenant + número verificado + wamid.
model PendingCloudReceipt {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        TenantSettings @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  phoneNumberId String         @map("phone_number_id")
  waMessageId   String         @map("wa_message_id")
  status        String
  statusAt      DateTime       @map("status_at")
  errorCode     Int?           @map("error_code")
  errorDetalle  String?        @map("error_detalle")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([phoneNumberId, waMessageId])
  @@index([tenantId, phoneNumberId])
  @@map("pending_cloud_receipts")
}

// ════════════════════════════════════════════════════════
// MOTOR v21 — Entrada y salida durables (Hito A, oct 2026)
// ════════════════════════════════════════════════════════
//
// POR QUÉ EXISTEN. Antes de esta versión el webhook contestaba 200 y después worked in
// memoria: debounce, locks y deduplicación vivían en el proceso. Un reinicio en ese
// hueco (Render duerme, deploy, caída) perdía el mensaje sin dejar rastro, y un reintento
// de Meta tras la caída se procesaba dos veces. En la salida el problema era el espejo:
// Meta aceptaba el envío y el insert del historial podía fallar después, dejando un
// mensaje que el cliente recibió pero que la bandeja no conoce.
//
// InboundEvent  = la entrada YA autenticada y routeada, persistida antes de responder.
//                 Identidad estable del evento (eventKey), estados de procesamiento,
//                 reclasificación por reintento acotado y recuperación tras reinicio.
// OutboundMessage = la intención de envío, durable ANTES de llamar a Meta, con el
//                 resultado o el estado INCIERTO cuando no se puede saber. Meta NO ofrece
//                 clave de idempotencia para POST /messages (verificado en su
//                 documentación): por eso nada se reenvía a ciegas tras una aceptación
//                 posible; queda incierto y visible para una resolución controlada.
//
// Los dos son append-only en su identidad: la deduplicación real es el índice único,
// no una marca en memoria.

// ─── Entrada durable (bandeja) ─────────────────────────────────
model InboundEvent {
  id            String   @id @default(uuid())
  // tenant_id sin default (mismo motivo que en Lead/Vendor: un tenant olvidado debe
  // FALLAR, no contaminar). Se escribe tras resolver el canal (phone_number_id → channel).
  tenantId      String   @map("tenant_id")
  tenant        TenantSettings @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  provider      String   @default("cloud")   // cloud | evolution
  // Identidad estable del evento en el proveedor. Para Cloud es el wamid del mensaje.
  // Es la clave de deduplicación REAL (junto con tenant + provider): repetir el mismo
  // evento no crea una segunda fila, y el replay posterior es idempotente por construcción.
  eventKey      String   @map("event_key")

  tipo          String   @default("message") // message | echo
  phoneNumberId String?  @map("phone_number_id")
  // Lo que el procesamiento necesita para volver a intentarlo sin volver a llamar a Meta:
  // remitente, tipo, texto, media_id, contexto de anuncio e interactivo. Datos del
  // mensaje entrante, nunca credenciales.
  payload       Json     @default("{}")

  // PENDING (pendiente de procesar) → PROCESSING (reclamado por un worker) →
  // DONE (procesado) · DISCARDED (descartado a propósito: sin remitente, lead archivado,
  // comprobante escalado) · FAILED (agotó sus reintentos). Solo PENDING es recuperable.
  estado        String   @default("PENDING")
  attempts      Int      @default(0)
  lastError     String?  @db.Text @map("last_error")

  // Ráfagas: el turno se agrupa 6 s desde el último mensaje. Se guarda como fecha en la
  // fila (no como timer en memoria) → tras un reinicio el mismo criterio sigue aplicando.
  disponibleEn  DateTime @map("disponible_en") @db.Timestamptz(6)
  // Reclamo: qué worker tomó la fila y cuándo. Si el proceso muere con la fila tomada,
  // la recuperación la devuelve a PENDING cuando el reclamo caduca.
  claimId       String?  @map("claim_id")
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)

  leadId        Int?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, provider, eventKey])
  @@index([estado, disponibleEn])
  @@index([leadId])
  @@map("inbound_events")
}

// ─── Salida durable (outbox con resultado incierto) ───────────
model OutboundMessage {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        TenantSettings @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  leadId        Int?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  origen        String   // BOT | VENDEDOR
  tipo          String   @default("text")    // text | template | image
  // Lo que se envía y con qué datos: texto, o nombre/idioma/componentes de plantilla,
  // o referencia de imagen. Sin credenciales (esas salen del canal en el momento del envío).
  payload       Json     @default("{}")
  canalRef      String?  @map("canal_ref")   // external_key / phone_number_id del canal

  // PENDING (intención durable, aún no enviada) → SENDING (llamada en curso) →
  // SENT (Meta aceptó; queda el wamid) · REJECTED (Meta rechazó: NO reenviar, se
  // marca fallido con su código) · UNCERTAIN (pudo aceptarse y no lo sabemos: NUNCA
  // se reenvía solo; queda visible y se resuelve a mano).
  estado        String   @default("PENDING")
  attempts      Int      @default(0)
  waMessageId   String?  @map("wa_message_id")
  // Fila de `messages` ya creada. Si Meta aceptó y este insert falla, la recuperación
  // lo reintenta por wamid (único) sin volver a enviar.
  messageId     Int?     @map("message_id")
  lastError     String?  @db.Text @map("last_error")
  errorCode     Int?     @map("error_code")
  claimId       String?  @map("claim_id")
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  // Cuándo se resolvió un estado incierto a mano (operador), para auditoría.
  resueltoPor   String?  @map("resuelto_por")
  resueltoAt    DateTime? @map("resuelto_at") @db.Timestamptz(6)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([tenantId, estado])
  @@index([leadId])
  @@map("outbound_messages")
}

// ─── Media entrante (comprobantes, fotos del lead) ────────────
// El lead manda una imagen por WhatsApp → el cerebro la baja para que Gemini la
// lea, y AHORA además la persistimos para mostrarla en el Inbox. `storage` es la
// costura: hoy 'pg' (bytes en la BD, servidos por endpoint propio con JWT → cero
// URL pública = no fuga de PII financiera del comprobante). Migrable a 'supabase'
// (bucket privado + signed URLs) si el volumen crece. `messageId` linkea al mensaje
// marcador del timeline. NO se relaciona a Message (tabla caliente) → Int suelto.
model MediaAsset {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageId   Int?     @map("message_id")
  tenantId    String?  @map("tenant_id")
  origen      String   @default("LEAD")            // LEAD | VENDEDOR
  tipo        String                                // image | audio
  mimeType    String   @map("mime_type")
  storage     String   @default("pg")              // pg | supabase
  bytes       Bytes?                                // si storage=pg
  url         String?                               // si storage=supabase
  sizeBytes   Int?     @map("size_bytes")
  createdAt   DateTime @default(now())             @map("created_at") @db.Timestamptz(6)

  @@index([leadId])
  @@map("media_assets")
}

// ─── Configuración del bot ────────────────────────────────────
model BotConfig {
  id              String   @id
  // Sin default (jul 2026): tenía @default("hidata") —un tercer valor de tenant, distinto
  // de los reales— y cualquier config sin tenant caía ahí. El único create (config.js)
  // ya pasa el tenant del admin explícito. Obligatorio para que un olvido falle, no mezcle.
  tenantId        String
  activo          Boolean  @default(true)
  nombre          String?
  msgBienvenida   String?  @db.Text
  msgProducto     String?  @db.Text
  msgExperiencia  String?  @db.Text
  msgPresentacion String?  @db.Text
  msgObjecion     String?  @db.Text
  msgUrgencia     String?  @db.Text
  msgHandoff      String?  @db.Text
  nombreEmpresa   String?
  nombreProducto  String?
  updatedEn       DateTime @default(now())

  @@map("bot_config")
}

// ════════════════════════════════════════════════════════
// MOTOR v20 — Nueva arquitectura conversacional
// 4 capas: Perception, State, Policy, Response
// ════════════════════════════════════════════════════════

// ─── Estado conversacional vivo ───────────────────────────────
model LeadState {
  leadId             Int      @id @map("lead_id")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  currentMode        String   @default("AUTO_CONSULTIVO") @map("current_mode")
  currentStage       String   @default("greeting")        @map("current_stage")
  slotsFilled        Json     @default("{}")              @map("slots_filled")
  slotsPending       String[] @default([])                @map("slots_pending")
  intentosPorSlot    Json     @default("{}")              @map("intentos_por_slot")
  
  vendorActiveId     Int?                                 @map("vendor_active_id")
  vendor             Vendor?  @relation(fields: [vendorActiveId], references: [id], onDelete: SetNull)
  
  modeEnteredAt      DateTime @default(now())             @map("mode_entered_at")
  lastMessageAt      DateTime @default(now())             @map("last_message_at")
  returningLeadFlag  Boolean  @default(false)             @map("returning_lead_flag")

  // Etiqueta MANUAL del vendedor (CRM), distinta de la temperatura que detecta el
  // cerebro. Columna propia (no en slots_filled) → inmune al upsert del bot. Texto
  // libre en la BD; la taxonomía válida la fija la capa app (inbox-actions).
  label              String?                              @map("label")

  // ── Turno pendiente de confirmar (Hito A3, oct 2026) ──
  // Antes el pipeline guardaba stage + slots ANTES de enviar y nada decía si el envío
  // terminó. Un turno descartado (respuesta obsoleta) o un envío rechazado dejaban un
  // avance comercial que el cliente nunca recibió: "pedido confirmado" sin mensaje.
  //
  // Ahora se separa lo que el LEAD APORTÓ (slots sin prefijo `_`, se guardan siempre:
  // son hechos de la conversación) de lo que depende de una acción SALIENTE (etapa,
  // pedido, cierre, escalado, compromisos). Lo segundo queda en `turnoPendiente` con su
  // `turnoId` y se confirma con `confirmarTurno` solo cuando Meta aceptó el envío.
  // Un descarte de turno viejo solo limpia SU turnoId: nunca pisa el turno siguiente.
  stateVersion       Int      @default(1)  @map("state_version")
  turnoId            String?   @map("turno_id")
  turnoPendiente     Json?     @map("turno_pendiente")
  
  createdAt          DateTime @default(now())             @map("created_at")
  updatedAt          DateTime @default(now())             @updatedAt @map("updated_at")

  @@map("lead_state")
}

// ─── Trace inmutable de cada turno conversacional ─────────────
model TurnTrace {
  turnId               String        @id @default(uuid()) @map("turn_id") @db.Uuid
  
  leadId               Int?          @map("lead_id")
  lead                 Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadIdArchived       Int?          @map("lead_id_archived")
  
  conversationId       Int?          @map("conversation_id")
  conversation         Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  
  resetGeneration      Int           @default(1) @map("reset_generation")
  dataQuality          String        @default("real_pilot") @map("data_quality")
  
  leadMessage          String        @db.Text @map("lead_message")
  leadMessageType      String        @default("text") @map("lead_message_type")
  
  perception           Json          @default("{}")
  perceptionVersion    String?       @map("perception_version")
  
  stateBefore          Json          @default("{}") @map("state_before")
  stateAfter           Json          @default("{}") @map("state_after")
  
  modeRouterDecision   Json          @default("{}") @map("mode_router_decision")
  
  policyDecision       Json          @default("{}") @map("policy_decision")
  policyVersion        String?       @map("policy_version")
  guardrailsEvaluated  String[]      @default([])  @map("guardrails_evaluated")
  
  botResponse          String?       @db.Text @map("bot_response")
  responseVersion      String?       @map("response_version")
  
  modelUsed            String?       @map("model_used")
  
  auditLog             Json          @default("{}") @map("audit_log")
  errors               Json          @default("[]")
  
  latencyMs            Int?          @map("latency_ms")
  modelCosts           Json          @default("{}") @map("model_costs")
  
  piiRedactedAt        DateTime?     @map("pii_redacted_at") @db.Timestamptz(6)
  
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("turn_trace")
}

// ─── Eventos de llamada con outcome tagging ───────────────────
model CallEvent {
  id                    String       @id @default(uuid())
  leadId                Int          @map("lead_id")
  lead                  Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendorId              Int          @map("vendor_id")
  vendor                Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  scheduledAt           DateTime?    @map("scheduled_at")
  occurredAt            DateTime?    @map("occurred_at")
  durationSeconds       Int?         @map("duration_seconds")
  
  outcomeTag            String?      @map("outcome_tag")
  modalidadAcordada     String?      @map("modalidad_acordada")
  fechaProximoEvento    DateTime?    @map("fecha_proximo_evento")
  condicionesEspeciales String?      @db.Text @map("condiciones_especiales")
  vendorNotes           String?      @db.Text @map("vendor_notes")
  voiceNoteUrl          String?      @map("voice_note_url")
  
  commitments           Commitment[]
  
  createdAt             DateTime     @default(now()) @map("created_at")

  @@map("call_events")
}

// ─── Compromisos extraídos ────────────────────────────────────
model Commitment {
  id               String     @id @default(uuid())
  leadId           Int        @map("lead_id")
  lead             Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callEventId      String?    @map("call_event_id")
  callEvent        CallEvent? @relation(fields: [callEventId], references: [id], onDelete: SetNull)
  
  description      String     @db.Text
  dueDate          DateTime   @map("due_date")
  fulfilled        Boolean    @default(false)
  fulfilledAt      DateTime?  @map("fulfilled_at")
  
  reminderSent     Boolean    @default(false) @map("reminder_sent")
  reminderSentAt   DateTime?  @map("reminder_sent_at")
  
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")

  @@map("commitments")
}

// ─── Cola de followup automático ──────────────────────────────
model FollowupQueueItem {
  id               String    @id @default(uuid())
  leadId           Int       @map("lead_id")
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  scheduledFor     DateTime  @map("scheduled_for")
  contextSnapshot  Json      @default("{}") @map("context_snapshot")
  followupType     String    @default("soft_reengagement") @map("followup_type")
  
  executed         Boolean   @default(false)
  executedAt       DateTime? @map("executed_at")
  result           String?   @db.Text
  
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("followup_queue")
}

// ─── Notificaciones priorizadas para CRM ──────────────────────
model CrmNotification {
  id               String    @id @default(uuid())
  vendorId         Int       @map("vendor_id")
  vendor           Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  leadId           Int?      @map("lead_id")
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  priority         String
  title            String
  message          String    @db.Text
  payload          Json      @default("{}")
  
  acknowledged     Boolean   @default(false)
  acknowledgedAt   DateTime? @map("acknowledged_at")
  
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("crm_notifications")
}

// Candado de envío del motor de followups (Hito A4, oct 2026).
// El flag en memoria de /cron/followup solo serializa corridas DENTRO del proceso; dos
// processes (o dos disparos solapados tras un reintento) leían el mismo lead como elegible
// y mandaban el mismo recordatorio dos veces. Aquí la reserva vive en la BD: la unicidad de
// (lead_id, followup_type, cycle_key) hace que la segunda corrida no pueda tomar lo mismo.
// `cycle_key` agrupa por hora para el followup por silencio y por compromiso para el
// recordatorio de fecha (uno por compromiso, no por hora).
model FollowupReservation {
  id               String   @id @default(uuid())
  leadId           Int      @map("lead_id")
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followupType     String   @map("followup_type")
  cycleKey         String   @map("cycle_key")
  contextSnapshot  Json     @default("{}") @map("context_snapshot")
  executed         Boolean  @default(false)
  executedAt       DateTime? @map("executed_at") @db.Timestamptz(6)
  messageId        String?  @map("message_id")
  result           String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([leadId, followupType, cycleKey])
  @@index([executed, createdAt])
  @@map("followup_reservations")
}

// ─── Lista de teléfonos de prueba ─────────────────────────────
model TestPhone {
  telefono     String   @id
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  addedBy      String?  @map("added_by")
  description  String?

  @@map("test_phones")
}

// ════════════════════════════════════════════════════════
// MULTI-TENANT INFRASTRUCTURE
// ════════════════════════════════════════════════════════

// ─── Configuración por tenant + suscripción + quotas ──────────
model TenantSettings {
  tenantId                       String   @id @map("tenant_id")
  displayName                    String   @map("display_name")
  
  // Modelo de suscripción
  numVendedoresPagados           Int      @default(0)     @map("num_vendedores_pagados")
  precioPorVendedorUsd           Decimal  @default(20.00) @map("precio_por_vendedor_usd") @db.Decimal(10,2)
  periodoMeses                   Int      @default(6)     @map("periodo_meses")
  fechaInicio                    DateTime?                @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin                       DateTime?                @map("fecha_fin") @db.Timestamptz(6)
  montoTotalPagadoUsd            Decimal?                 @map("monto_total_pagado_usd") @db.Decimal(10,2)
  estadoSuscripcion              String   @default("trial") @map("estado_suscripcion")
  
  // Quota operativa de turnos IA
  turnosIncluidosPorVendedorMes  Int      @default(10000) @map("turnos_incluidos_por_vendedor_mes")
  turnosConsumidosMesActual      Int      @default(0)     @map("turnos_consumidos_mes_actual")
  // Hito A4 (oct 2026): "turno atendido" NO es "gasto de modelo". Muchos turnos se resuelven
  // por regla determinista (vulnerabilidad, llamada, pedido) con 0 tokens; sumarlos al
  // contador de cuota como si costaran dineroEra una lectura engañosa. Este contador
  // separa los turnos que SÍ llamaron a un proveedor de IA. La política de cuota NO cambia
  // (sigue contando turnos atendidos) y no se corta atención: esto solo hace la métrica
  // honesta. Ver docs/estado-despliegue-crm.json y el panel de métricas.
  turnosIaMesActual              Int      @default(0)     @map("turnos_ia_mes_actual")
  mesActualInicio                DateTime @default(dbgenerated("date_trunc('month'::text, now())")) @map("mes_actual_inicio") @db.Timestamptz(6)
  
  // API key dedicada (futuro multi-tenant real)
  geminiApiKeyEncrypted          String?  @map("gemini_api_key_encrypted")
  byokEnabled                    Boolean  @default(false) @map("byok_enabled")
  
  // Metadata
  notas                          String?  @db.Text

  // Canales de WhatsApp de este tenant (su número / su instancia).
  // Es lo que convierte a tenant_settings en el ANCLA del multitenant: un tenant
  // ya no es solo una fila de facturación, es "quién atiende por qué número".
  channels                       Channel[]
  pendingCloudReceipts            PendingCloudReceipt[]
  inboundEvents                  InboundEvent[]
  outboundMessages               OutboundMessage[]

  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_settings")
}

// ─── Canal de WhatsApp por tenant ─────────────────────────────
//
// LA PIEZA QUE MATA `ACTIVE_TENANT`.
//
// Hasta hoy el tenant activo era una ENV VAR global del proceso: un deploy
// atendía a UN cliente, y sumar el segundo obligaba a levantar otro servicio o
// a apagar el primero. El número entrante ya traía la respuesta y la tirábamos.
//
// Ahora el tenant se DEDUCE del canal por el que entró el mensaje:
//
//   webhook → externalKey (instancia Evolution / phone_number_id) → Channel → tenantId
//
// Con eso los 3 clientes conviven en UN solo deploy, cada uno con su número, y
// sumar el cuarto es INSERTAR UNA FILA — no un redeploy.
//
// `provider` es la costura de portabilidad: hoy todo es 'evolution'; el día que
// un cliente llegue con Bird o Cloud API se agrega su adapter y su fila, y los
// demás siguen intactos. Ningún proveedor queda cableado en el pipeline.
//
// `credenciales` guarda lo específico de cada proveedor (JSON, cifrado en reposo
// a nivel de Postgres/Supabase). NUNCA en env vars: eso es lo que impedía tener
// dos clientes a la vez.
//   evolution → { apiUrl, apiKey, instanceName }
//   bird      → { workspaceId, wabaId, phoneNumberId, accessToken }
//   cloud     → { phoneNumberId, wabaId, accessToken, appSecret }
model Channel {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  tenant         TenantSettings @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  provider       String         @default("evolution")   // evolution | bird | cloud

  // Cómo está conectado el número cuando provider='cloud'. La API es la MISMA en los dos
  // casos (mismo webhook, mismo phone_number_id, mismo envío); lo que cambia es que en
  // coexistencia el número sigue vivo en la app del celular del cliente y Meta nos manda
  // una copia de lo que él contesta desde ahí (ver 'echo' en cloud/parser.js).
  // Se guarda para saber a quién hay que migrar y para no sorprenderse con los ecos.
  modo           String         @default("nube_pura")   // nube_pura | coexistencia

  // Llave de routing del webhook entrante. ÚNICA GLOBAL a propósito: una misma
  // instancia/número no puede pertenecer a dos tenants — si eso pasara, los
  // mensajes de un cliente caerían en la bandeja de otro. El índice único lo
  // vuelve imposible a nivel BD, no solo por disciplina de código.
  externalKey    String         @unique @map("external_key")

  numeroDisplay  String?        @map("numero_display")  // +51924104066 (informativo, para el dashboard)
  credenciales   Json?                                   // por proveedor (ver arriba)

  activo         Boolean        @default(true)
  // Canal por defecto del tenant para ENVIAR cuando el turno no trae uno propio
  // (p.ej. followups del cron, que nacen sin webhook entrante).
  esDefault      Boolean        @default(false)         @map("es_default")

  notas          String?        @db.Text

  createdAt      DateTime       @default(now())         @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([provider, activo])
  @@map("channels")
}
