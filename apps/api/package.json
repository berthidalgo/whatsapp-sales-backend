{
  "name": "whatsapp-sales-backend",
  "version": "7.0.0",
  "description": "Hidata v20 — WhatsApp-native Sales Operating System for LATAM edtech",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node --import ./instrument.mjs src/server.js",
    "test": "node --test --test-isolation=none",
    "build": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.cjs",
    "test:offline": "node --import ./tests/helpers/offline-guard.mjs --test --test-isolation=none",
    "test:db": "node --import ./tests/helpers/offline-guard.mjs --test tests/integration/crm-postgres.mjs",
    "db:plan": "node scripts/preparar-db-crm.js",
    "db:prepare": "node scripts/preparar-db-crm.js --aplicar",
    "db:verify": "node scripts/verificar-db-crm.js",
    "db:contract": "node scripts/generar-contrato-db.js --actualizar"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@google/genai": "^2.8.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.75.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "pg": "^8.21.0",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
